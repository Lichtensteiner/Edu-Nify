// 9. Delete Online Session
export const deleteOnlineSession = async (sessionId: string) => {
  try {
    const docRef = doc(db, 'online_sessions', sessionId);
    await deleteDoc(docRef);

    // Also clean up any attendance records linked to this session
    try {
      const attSnap = await getDocs(query(collection(db, 'online_attendance'), where('sessionId', '==', sessionId)));
      const delPromises = attSnap.docs.map(d => deleteDoc(d.ref));
      await Promise.all(delPromises);
    } catch (e) {
      console.warn("Could not clean up attendance records on session delete:", e);
    }
  } catch (error) {
    console.error("Error deleting online session:", error);
    throw error;
  }
};

